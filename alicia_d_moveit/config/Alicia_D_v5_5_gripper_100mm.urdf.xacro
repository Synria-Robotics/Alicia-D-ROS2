<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="Alicia_D_v5_5_gripper_100mm">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import alicia_d_descriptions urdf file for v5_5 100mm -->
    <xacro:include filename="$(find alicia_d_descriptions)/urdf/Alicia_D_v5_5/Alicia_D_gripper_100mm.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="alicia_d_descriptions.ros2_control.xacro" />

    <!-- Use FakeSystem for demo mode -->
    <xacro:alicia_d_descriptions_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>

